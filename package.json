{
  "name": "ndspalib-v2",
  "version": "2.0.0",
  "description": "A JavaScript SPA Framework",
  "author": "Martin Mohnhaupt",
  "license": "ISC",
  "keywords": [],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "./dist"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "clean": "rimraf ./dist",
    "build": "npm run clean && tsc -p ./tsconfig.prod.json && tsc-alias -p ./tsconfig.prod.json",
    "release": "clear && npm run build && esbuild src/main/main.ts  --bundle --minify --outfile=release/ndspalib.js --global-name='nd_core'"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "bootstrap": "^5.3.8",
    "html5-qrcode": "^2.3.8",
    "json5": "^2.2.3",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.5",
    "typescript": "^7.0.2",
    "uuid": "^14.0.2"
  }
}
